  "Definition of Terms": {
    "Examination": "A formal assessment conducted by the university to evaluate a student's knowledge, understanding, and performance in a course unit.",
    "Session": "An academic period, usually covering one full academic year, during which teaching, learning, and examinations are conducted.",
    "Semester": "A division of an academic session into two parts, each consisting of a defined period of teaching and assessment.",
    "Year of Study": "The academic level of a student in a programme, such as First Year, Second Year, Third Year, or Final Year.",
    "Programme of Study": "An approved academic course of learning leading to the award of a certificate, diploma, or degree by the university.",
    "Course Unit": "A single subject or module offered within a programme, assigned a specific credit value.",
    "Course Units": "All individual subjects or modules registered by a student in a particular semester or session.",
    "Grade Point": "A numerical value assigned to a letter grade, used to calculate academic performance.",
    "Credit Point": "The weighted value obtained by multiplying the grade point by the credit unit of a course.",
    "Grade Point Average GPA": "The average of credit points earned divided by the total credit units registered in a semester or session.",
    "Cumulative Grade Point Average CGPA": "The overall average of credit points earned across all completed semesters divided by the total credit units attempted.",
    "Probation": "An academic status assigned to a student whose performance falls below the minimum acceptable standard, requiring improvement in subsequent semesters.",
    "Withdrawal": "The academic status applied when a student is required to discontinue studies due to consistently poor academic performance or violation of university regulations."
  }
}