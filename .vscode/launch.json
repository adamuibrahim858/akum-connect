    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flutter: Run on Device",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart"
        },
        {
            "name": "Flutter: Run on Web (Chrome)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "args": ["-d", "chrome"]
        },
        {
            "name": "Flutter: Attach to Device",
            "type": "dart",
            "request": "attach"
        }
    ]
}